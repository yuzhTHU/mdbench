            "payload_type": "function_call",
            "raw_text": "{\"cmd\": \"cd /ram/tmp/mdbench-codex-zxkjwnar/workspace && /home/test/test06/mdbench-runtime-numpy235-20260923-a1Cx0t/bin/python -c \\\"\\nimport numpy as np\\nfrom scipy.optimize import least_squares\\nd=np.load('train.npy');resp,s,a,b=d\\nN=len(resp)\\n# build KD-ish: quantize a,b into grid, collect groups\\nai=(a/0.02).astype(int); bi=(b/0.02).astype(int)\\nfrom collections import defaultdict\\ngroups=defaultdict(list)\\nfor i in range(N): groups[(ai[i],bi[i])].append(i)\\n# fit single pole A/(s+lam) within each group with >=4 distinct s\\nres=[]\\nfor g,idx in groups.items():\\n    if len(idx)<5: continue\\n    idx=np.array(idx)\\n    sg, rg = s[idx], resp[idx]\\n    if len(np.unique(np.round(sg,2)))<4: continue\\n    try:\\n        p=least_squares(lambda p: p[0]/(sg+p[1])-rg,[np.mean(rg),0.5]).x\\n        pr=p[0]/(sg+p[1])\\n        e=np.sqrt(np.mean(((pr-rg)/rg)**2))\\n        if e<0.08:\\n            res.append((np.log(np.mean(a[idx])),np.log(np.mean(b[idx])),np.log(p[0]),np.log(max(p[1],1e-3)),e))\\n    except Exception as ex: pass\\nres=np.array(res)\\nprint('n groups',len(res))\\nprint('mean rel err',res[:,4].mean())\\n# regression logA on loga,logb ; loglam\\nX=np.column_stack([np.ones(len(res)),res[:,0],res[:,1]])\\ndef lin(y):\\n    return np.linalg.lstsq(X,y,rcond=None)[0]\\nca=lin(res[:,2]); cl=lin(res[:,3])\\nprint('logA coeff(const,la,lb):',ca)\\nprint('loglam coeff:',cl)\\n# also A and lam raw regression\\n\\\"\"}"
