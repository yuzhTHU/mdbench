            "verbatim": "{\"cmd\": \"cd /ram/tmp/mdbench-codex-97vggvh7/workspace && /home/test/test06/mdbench-runtime-patch188-20260923-EZhFxx/bin/python -c \\\"\\nimport numpy as np\\nd = np.load('train.npy')\\nresp = d[0]; s = d[1]; a = d[2]; b = d[3]\\ny=np.log(resp)\\nfrom scipy.optimize import least_squares\\n# R = c ab/((1+k1a+k2b)(1+k3a+k4b)) * 1/(1+(s/L)^n)   with L const\\ndef make(Tshape):\\n    def model(p):\\n        c,k1,k2,k3,k4,L,n=p\\n        Rab=c*a*b/((1+k1*a+k2*b)*(1+k3*a+k4*b))\\n        if Tshape=='sig':\\n            T=1/(1+(s/abs(L))**n)\\n        elif Tshape=='exp':\\n            T=np.exp(-s/abs(L))\\n        elif Tshape=='pole':\\n            T=abs(L)/(s+abs(L))\\n        pr=Rab*T\\n        return np.log(np.maximum(pr,1e-12))-y\\n    return model\\nfor shape in ['sig','exp','pole']:\\n    best=[]\\n    for init in [[1.6,1.7,0.9,0,0.2,0.3,1.2],[1,1,1,0,0,0.5,1.0]]:\\n        try:\\n            r=least_squares(make(shape),init,method='lm',max_nfev=100000)\\n            best.append((np.sqrt(np.mean(r.fun**2)),r.x))\\n        except Exception as e:\\n            best.append((1e9,str(e)[:40]))\\n    best.sort(key=lambda t:t[0])\\n    print(shape,'best RMS',best[0][0],'x',best[0][1])\\n\\\"\"}"
