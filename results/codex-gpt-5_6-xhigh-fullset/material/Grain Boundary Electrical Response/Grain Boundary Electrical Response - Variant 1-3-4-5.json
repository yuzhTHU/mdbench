  "submission": "reference_temperature = 300\ngrain_boundary_thickness = 3.0046258960485137e-06\ntemperature_offset = temperature - reference_temperature\ngrain_interior_resistivity = 1.2482072543999772*(1 + 0.0033065445844209823*temperature_offset)\ngrain_interior_relaxation_time = 2.6608555495466042e-09*(1 + 0.0029497681297290879*temperature_offset)\ngrain_interior_relaxation_exponent = 0.97456919007189935\ngrain_boundary_resistance_area = 5.3890490186659872e-05*(1 + 0.0034431043939063834*temperature_offset)\ngrain_boundary_relaxation_time = 1.9714769583619618e-08*(1 + 0.0051346316578814808*temperature_offset)\ngrain_boundary_relaxation_exponent = 0.94314713944872497\ngrain_interior_impedance_area = grain_interior_resistivity*grain_size/(1 + (laplace_rate*grain_interior_relaxation_time)^grain_interior_relaxation_exponent)\ngrain_boundary_impedance_area = grain_boundary_resistance_area/(1 + (laplace_rate*grain_boundary_relaxation_time)^grain_boundary_relaxation_exponent)\nsegment_impedance_area = grain_interior_impedance_area + grain_boundary_impedance_area\nsegment_length = grain_size + grain_boundary_thickness\nconductivity = segment_length/segment_impedance_area\n",
