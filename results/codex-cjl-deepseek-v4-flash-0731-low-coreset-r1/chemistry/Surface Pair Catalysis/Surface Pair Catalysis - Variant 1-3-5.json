            "payload_type": "function_call",
            "verbatim": "{\"cmd\": \"cd /ram/tmp/mdbench-codex-g7dley29/workspace && /home/test1267/test-6/miniconda3/bin/python3 -c \\\"\\nimport numpy as np\\nfrom scipy.optimize import least_squares\\nd=np.load('train.npy'); r,s,a,b=d\\n# pick window\\ndef analyze(a0,b0,da=0.1,db=0.1,nlam=2):\\n    m=(np.abs(a-a0)<da)&(np.abs(b-b0)<db)\\n    if m.sum()<8: return None\\n    sm,rm=s[m],r[m]\\n    # fit rm = sum wi lam_i/(s+lam_i), wi>0\\n    def resid(p):\\n        w=p[:nlam]; lam=np.exp(p[nlam:])\\n        pred=sum(w[i]*lam[i]/(sm+lam[i]) for i in range(nlam))\\n        return pred-rm\\n    p0=list(np.full(nlam,rm.max()/nlam))+list(np.log([0.5,1.5][:nlam]))\\n    sol=least_squares(resid,p0)\\n    w=sol.x[:nlam]; lam=np.exp(sol.x[nlam:])\\n    pred=sum(w[i]*lam[i]/(sm+lam[i]) for i in range(nlam))\\n    r2=1-np.sum((rm-pred)**2)/np.sum((rm-rm.mean())**2)\\n    return w,lam,r2,m.sum(),sm.min(),sm.max()\\nfor (a0,b0) in [(0.5,0.5),(0.8,0.8),(1.0,0.4),(0.3,1.0),(0.5,1.2)]:\\n    print('a,b=',a0,b0)\\n    for nlam in [1,2]:\\n        z=analyze(a0,b0,nlam=nlam)\\n        if z: print('  lam',nlam,'w',np.round(z[0],4),'lam',np.round(z[1],3),'r2',round(z[2],4),'n',z[3],'srange',round(z[4],2),round(z[5],2))\\n\\\"\"}"
